{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/partner", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partner/:path*", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partner-with-us/supply", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partner-with-us/demand", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partner-with-us/enterprise", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partner-with-us/case-studies/:path*", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/supply", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/demand", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/enterprise", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/case-studies/amazon", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/lenders", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/affiliate", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partners", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partners/:path*", "destination": "/partner-with-us/", "permanent": true }
  ]
}
