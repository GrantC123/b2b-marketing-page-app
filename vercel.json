{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/partner", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partner/:path*", "destination": "/partner-with-us/:path*/", "permanent": true },
    { "source": "/supply", "destination": "/partner-with-us/supply/", "permanent": true },
    { "source": "/demand", "destination": "/partner-with-us/demand/", "permanent": true },
    { "source": "/enterprise", "destination": "/partner-with-us/enterprise/", "permanent": true },
    { "source": "/case-studies/amazon", "destination": "/partner-with-us/case-studies/amazon/", "permanent": true },
    { "source": "/lenders", "destination": "/partner-with-us/supply/", "permanent": true },
    { "source": "/affiliate", "destination": "/partner-with-us/demand/", "permanent": true },
    { "source": "/partners", "destination": "/partner-with-us/", "permanent": true },
    { "source": "/partners/lenders", "destination": "/partner-with-us/supply/", "permanent": true },
    { "source": "/partners/enterprise", "destination": "/partner-with-us/enterprise/", "permanent": true },
    { "source": "/partners/affiliate", "destination": "/partner-with-us/demand/", "permanent": true },
    { "source": "/rate-table-preview", "destination": "/rate-table-preview.html", "permanent": false },
    { "source": "/savings-accounts-preview", "destination": "/savings-accounts-preview.html", "permanent": false }
  ]
}
