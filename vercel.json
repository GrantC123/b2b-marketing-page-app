{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/supply", "destination": "/partner/supply", "permanent": true },
    { "source": "/demand", "destination": "/partner/demand", "permanent": true },
    { "source": "/enterprise", "destination": "/partner/enterprise", "permanent": true },
    { "source": "/case-studies/amazon", "destination": "/partner/case-studies/amazon", "permanent": true },
    { "source": "/lenders", "destination": "/partner/supply", "permanent": true },
    { "source": "/affiliate", "destination": "/partner/demand", "permanent": true },
    { "source": "/partners", "destination": "/partner", "permanent": true },
    { "source": "/partners/lenders", "destination": "/partner/supply", "permanent": true },
    { "source": "/partners/enterprise", "destination": "/partner/enterprise", "permanent": true },
    { "source": "/partners/affiliate", "destination": "/partner/demand", "permanent": true }
  ]
}
